FROM python:3.14.5-slim-trixie
WORKDIR /app

# Install system dependencies needed for Python packages (e.g., psycopg2)
RUN apt update 
RUN apt install -y mariadb-client build-essential pkg-config python3-dev default-libmysqlclient-dev build-essential nodejs npm
COPY requirements.txt .

# ENV PYTHONUNBUFFERED=1
COPY . /app
RUN mkdir /app/static

RUN pip install --no-cache-dir -r requirements.txt
RUN pip install gunicorn | tee pip-install.out

WORKDIR /app/frontend
# Suggestion for the Docker maintainer: the line below installs ALL dependencies,
# including front-end test tooling (vitest, @testing-library/*, jsdom) that the
# production image never needs. To exclude them, replace `npm install` with:
#   RUN npm install --omit=dev
# (Test devDependencies are only used by `npm test`, not by `npm run build`.)
RUN npm install
RUN npm run build

WORKDIR /app/frontend

# Run collectstatic (configure in settings)
# RUN python manage.py collectstatic --noinput
# EXPOSE 8000
EXPOSE 9000
# Use Gunicorn as the production WSGI server, not the Django dev server
# CMD ["gunicorn", "--bind", ":8000", "--workers", "3", "minibini.wsgi:application"]
# CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
# Start Vite dev server on :9000 (proxies /api to :8000)
CMD ["npx", "vite", "--host", "0.0.0.0"] 


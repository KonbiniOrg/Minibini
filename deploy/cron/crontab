# Minibini scheduled processes. Cron does not inherit the container env, so each
# job sources the exported env first. Output goes to PID 1 stdout (docker logs).
*/15 * * * * . /app/cron.env; cd /app && python manage.py poll_qbo_payments >> /proc/1/fd/1 2>&1
30 1 * * * . /app/cron.env; cd /app && python manage.py mark_estimates_expired >> /proc/1/fd/1 2>&1
0 2 * * * . /app/cron.env; cd /app && python manage.py cleanup_temp_emails >> /proc/1/fd/1 2>&1

